{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["dependencies"],
  "properties": {
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source", "installMode"],
        "properties": {
          "source": { "type": "string" },
          "path": { "type": "string" },
          "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "ref": { "type": "string" },
          "version": { "type": "string" },
          "commit": { "type": "string" },
          "installMode": {
            "type": "string",
            "enum": ["offline", "j-skills"]
          },
          "installedAt": { "type": "string", "format": "date-time" },
          "localPath": { "type": "string" }
        },
        "oneOf": [
          {
            "properties": {
              "source": { "const": "local" }
            },
            "required": ["localPath"]
          },
          {
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^github:[^/]+/[^/]+$"
              }
            },
            "required": ["path"]
          },
          {
            "properties": {
              "source": { "const": "github" }
            },
            "required": ["repo", "path"]
          }
        ]
      }
    }
  }
}
